<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Caudal" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
    </style>
    <style name="Theme.Caudal.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_drop</item>
        <item name="windowSplashScreenAnimationDuration">700</item>
        <item name="postSplashScreenTheme">@style/Theme.Caudal</item>
    </style>
</resources>
